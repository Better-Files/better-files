{
  "name": "@better-files/react",
  "version": "0.1.0",
  "description": "React bindings for Better Files: a provider, typed query hooks, an uploader hook and a capability gate.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Better Files contributors",
  "homepage": "https://github.com/Better-Files/better-files/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
