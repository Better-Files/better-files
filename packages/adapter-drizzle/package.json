{
  "name": "@better-files/adapter-drizzle",
  "version": "0.1.0",
  "description": "Drizzle adapter for Better Files: run on the host's drizzle db (node-postgres, postgres.js, PGlite, better-sqlite3, libSQL), with a generated schema for drizzle-kit",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Better Files contributors",
  "homepage": "https://github.com/Better-Files/better-files/tree/main/packages/adapter-drizzle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Better-Files/better-files.git",
    "directory": "packages/adapter-drizzle"
  },
  "bugs": {
    "url": "https://github.com/Better-Files/better-files/issues"
  },
  "keywords": [
    "data-room",
    "better-iam",
    "typescript",
    "drizzle",
    "orm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@better-files/core": "workspace:*",
    "@better-files/adapter-sql": "workspace:*"
  },
  "peerDependencies": {
    "@better-files/adapter-sqlite": "workspace:*",
    "@better-files/adapter-postgres": "workspace:*",
    "@better-files/adapter-libsql": "workspace:*",
    "@better-files/adapter-pglite": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@better-files/adapter-sqlite": {
      "optional": true
    },
    "@better-files/adapter-postgres": {
      "optional": true
    },
    "@better-files/adapter-libsql": {
      "optional": true
    },
    "@better-files/adapter-pglite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@better-files/adapter-sqlite": "workspace:*",
    "@better-files/adapter-postgres": "workspace:*",
    "@better-files/adapter-libsql": "workspace:*",
    "@better-files/adapter-pglite": "workspace:*"
  }
}
