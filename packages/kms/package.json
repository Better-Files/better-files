{
  "name": "@better-files/kms",
  "version": "0.1.0",
  "description": "Bring-your-own-key providers for Better Files: AWS KMS, Google Cloud KMS, Azure Key Vault and HashiCorp Vault Transit over fetch (no SDKs), plus key migration between providers.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Better Files contributors",
  "homepage": "https://github.com/Better-Files/better-files/tree/main/packages/kms#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Better-Files/better-files.git",
    "directory": "packages/kms"
  },
  "bugs": {
    "url": "https://github.com/Better-Files/better-files/issues"
  },
  "keywords": [
    "data-room",
    "better-iam",
    "typescript",
    "kms",
    "byok",
    "encryption",
    "aws-kms",
    "vault"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@better-files/core": "workspace:*",
    "@better-files/crypto": "workspace:*",
    "@better-files/storage-s3": "workspace:*"
  }
}
