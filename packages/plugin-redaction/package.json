{
  "name": "@better-files/plugin-redaction",
  "version": "0.1.0",
  "description": "Redaction for Better Files: find sensitive text (emails, phone numbers, IDs, your patterns) and burn it out of PDFs and images as a new version or a redacted copy",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Better Files contributors",
  "homepage": "https://github.com/Better-Files/better-files/tree/main/packages/plugin-redaction#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Better-Files/better-files.git",
    "directory": "packages/plugin-redaction"
  },
  "bugs": {
    "url": "https://github.com/Better-Files/better-files/issues"
  },
  "keywords": [
    "data-room",
    "better-iam",
    "typescript",
    "redaction",
    "pdf",
    "privacy"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@better-files/core": "workspace:*"
  },
  "peerDependencies": {
    "pdf-lib": "^1.17.0",
    "unpdf": ">=1.0.0",
    "@napi-rs/canvas": ">=0.1.60"
  },
  "peerDependenciesMeta": {
    "pdf-lib": {
      "optional": true
    },
    "unpdf": {
      "optional": true
    },
    "@napi-rs/canvas": {
      "optional": true
    }
  },
  "devDependencies": {
    "unpdf": "^1.8.1",
    "@napi-rs/canvas": "^1.0.9",
    "pdf-lib": "^1.17.1"
  }
}
