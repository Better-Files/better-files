{
  "name": "@better-files/nestjs",
  "version": "0.1.0",
  "description": "NestJS integration for Better Files: a module that serves the protocol, a capability guard and decorators.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Better Files contributors",
  "homepage": "https://github.com/Better-Files/better-files/tree/main/packages/nestjs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Better-Files/better-files.git",
    "directory": "packages/nestjs"
  },
  "bugs": {
    "url": "https://github.com/Better-Files/better-files/issues"
  },
  "keywords": [
    "data-room",
    "better-iam",
    "typescript",
    "nestjs",
    "nest"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@better-files/core": "workspace:*",
    "@better-files/middleware": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  }
}
