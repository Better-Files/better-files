{
  "name": "@better-files/storage-s3",
  "version": "0.1.0",
  "description": "S3-compatible storage adapter for Better Files (AWS S3, Cloudflare R2, MinIO, B2, Wasabi) using SigV4 over fetch, no AWS SDK.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Better Files contributors",
  "homepage": "https://github.com/Better-Files/better-files/tree/main/packages/storage-s3#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Better-Files/better-files.git",
    "directory": "packages/storage-s3"
  },
  "bugs": {
    "url": "https://github.com/Better-Files/better-files/issues"
  },
  "keywords": [
    "data-room",
    "better-iam",
    "typescript",
    "storage",
    "s3",
    "r2",
    "minio"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@better-files/core": "workspace:*"
  }
}
