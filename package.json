{
  "name": "better-files-workspace",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false && tsc -p tests/tsconfig.json && tsc -p examples/tsconfig.json && tsc -p bench/tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm validate:packages",
    "validate:packages": "node scripts/validate-packages.mjs",
    "bench": "vitest bench --run --config bench/vitest.config.ts",
    "bench:targets": "vitest run --config bench/vitest.config.ts",
    "pack:all": "node scripts/pack.mjs",
    "smoke:packed": "node scripts/packed-smoke.mjs",
    "release:version": "node scripts/release-version.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@napi-rs/canvas": "1.0.9",
    "@opentelemetry/api": "^1.9.0",
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/testing": "^12.0.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-iam": "^0.2.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "fastify": "^5.12.5",
    "happy-dom": "^17.6.3",
    "hono": "^4.13.8",
    "pdf-lib": "^1.17.1",
    "pg-boss": "^12.36.0",
    "prettier": "3.6.2",
    "publint": "^0.3.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.4",
    "typescript": "^5.9.3",
    "unpdf": "^1.8.1",
    "vitest": "^3.2.4",
    "vue": "3.5.43"
  }
}
